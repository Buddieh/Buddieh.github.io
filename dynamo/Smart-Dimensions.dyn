  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "NodeType": "BooleanInputNode",
      "InputValue": true,
      "Id": "a1844906ff4448d79d53771b779f8398",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "8436b1f1b28c475fb509ada3146d1a91",
          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
