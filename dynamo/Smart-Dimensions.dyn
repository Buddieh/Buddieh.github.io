      "Replication": "Disabled",
      "Description": "Enables selection between True and False"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n\"\"\"\nSmart Dimensions for plans (Dynamo Player, Revit 2025+). Built for masonry plans,\nworks with any model category.\n\nWorkflow\n  1. Draw detail lines in the plan view with a dedicated line style\n     (for example \"DIM-PATH\" for detailed strings, \"DIM-PATH-OVERALL\" for overall strings).\n     Each line is where one dimension string will run. Draw it from grid to grid.\n  2. Run the graph from Dynamo Player. A dialog asks for the dimension type, the path\n     line styles, and in a category > type tree which types to dimension (Dimension tab)\n     and which to use as fixed anchors (Reference tab).\n  3. For every path line the script collects, in order along the line, per element kind:\n       - line   (grids, reference planes): where the line crosses them,\n       - wall   both faces of walls the line crosses; end faces and opening jambs of\n                walls parallel to the line within the search distance,\n       - family (columns, beams, doors, equipment...): first and last face along the\n                line, if the family lies within the search distance,\n       - host   (floors, roofs, foundations...): faces the line crosses,\n     merges coincident references and places one chained dimension on the line.\n  4. Segments between the two jambs of one opening get the opening height\n     (and the sill height for windows) as text below the value.\n\nThe pure logic (classification, merging, overall filter, opening detection) has no\nRevit dependency so it can be tested outside Revit.\n\"\"\"\n\nimport os\nimport json\nimport math\nimport traceback\n\n# ---------------------------------------------------------------------------\n# Constants (Revit internal units are feet)\n# ---------------------------------------------------------------------------\nFT_PER_CM = 1.0 / 30.48\nMERGE_TOL = 0.5 / 304.8          # 0.5 mm: references closer than this are merged\nLATERAL_TOL = 1.0 / 304.8        # 1 mm: tolerance for \"the path crosses this face\"\nPERP_DOT = 0.05                  # |cos| below this = wall perpendicular to the path\nPAR_DOT = 0.995                  # |cos| above this = wall parallel to the path\nFACE_PAR_DOT = 0.9999            # face normal must be this parallel to the path\nZ_TOL = 1.0 / 304.8              # 1 mm vertical tolerance\nSMALL_SEGMENT = 5.0 * FT_PER_CM\nGRID_END_TOL = 10.0 * FT_PER_CM  # a grid up to 10 cm past a path end still counts  # segments under 5 cm are reported (text overlap)\n\nPRIO_GRID = 4\nPRIO_REF_FACE = 3\nPRIO_HOST_FACE = 2\nPRIO_LINK_FACE = 1\n\nDEFAULT_SETTINGS = {\n    \"dimension_type\": \"\",\n    \"detail_style\": \"\",\n    \"overall_style\": \"\",\n    \"dim_types\": [],\n    \"ref_types\": [],\n    \"search_distance_cm\": 90.0,\n    \"replace_existing\": True,\n    \"debug\": False,\n    \"opening_text\": True,\n    \"height_prefix\": \"h=\",\n    \"sill_prefix\": \"bk=\",\n}\n\n\n# ---------------------------------------------------------------------------\n# Pure logic (no Revit)\n# ---------------------------------------------------------------------------\ndef dot2(a, b):\n    return a[0] * b[0] + a[1] * b[1]\n\n\ndef classify_wall(wall_dir, path_dir):\n    \"\"\"'perp' when the wall crosses the path, 'par' when it runs alongside, else None.\"\"\"\n    c = abs(dot2(wall_dir, path_dir))\n    if c < PERP_DOT:\n        return \"perp\"\n    if c > PAR_DOT:\n        return \"par\"\n    return None\n\n\ndef face_hit(face, path_p0, path_dir, path_len, wall_kind, search_dist):\n    \"\"\"\n    Decide if a vertical planar face is a witness line target for the path.\n\n    face: dict with n (2D unit normal), c (plane offset: dot(n, X) = c),\n          umin/umax (extent along the horizontal tangent u = (-ny, nx)).\n    Returns (t, normal_sign) or None. t = distance along the path.\n    \"\"\"\n    n = face[\"n\"]\n    nd = dot2(n, path_dir)\n    if abs(nd) < FACE_PAR_DOT:\n        return None\n    t = (face[\"c\"] - dot2(n, path_p0)) / nd\n    if t < -MERGE_TOL or t > path_len + MERGE_TOL:\n        return None\n    u = (-n[1], n[0])\n    s = dot2(u, path_p0)\n    umin, umax = face[\"umin\"], face[\"umax\"]\n    if wall_kind == \"perp\":\n        if not (umin - LATERAL_TOL <= s <= umax + LATERAL_TOL):\n            return None\n    elif wall_kind in (\"par\", \"near\"):\n        dist = max(umin - s, s - umax, 0.0)\n        if dist > search_dist:\n            return None\n    else:\n        return None\n    return t, (1 if nd > 0 else -1)\n\n\ndef grid_hit(g0, gdir, path_p0, path_dir, path_len):\n    \"\"\"Distance along the path where it crosses the (unbounded) grid line, or None.\"\"\"\n    cross = path_dir[0] * gdir[1] - path_dir[1] * gdir[0]\n    if abs(cross) < PERP_DOT:\n        return None\n    wx, wy = g0[0] - path_p0[0], g0[1] - path_p0[1]\n    t = (wx * gdir[1] - wy * gdir[0]) / cross\n    if t < -GRID_END_TOL or t > path_len + GRID_END_TOL:\n        return None\n    return t\n\n\ndef merge_candidates(cands, tol=MERGE_TOL):\n    \"\"\"\n    cands: list of dicts {t, ref, prio, meta}. Sort along the path and merge\n    references closer than tol. The highest priority reference represents the\n    cluster; all metas are kept (needed for opening detection).\n    \"\"\"\n    out = []\n    for c in sorted(cands, key=lambda x: x[\"t\"]):\n        if out and abs(c[\"t\"] - out[-1][\"t_last\"]) <= tol:\n            cl = out[-1]\n            cl[\"metas\"].append(c[\"meta\"])\n            cl[\"t_last\"] = c[\"t\"]\n            if c[\"prio\"] > cl[\"prio\"]:\n                cl[\"prio\"], cl[\"ref\"], cl[\"t\"] = c[\"prio\"], c[\"ref\"], c[\"t\"]\n        else:\n            out.append({\"t\": c[\"t\"], \"t_last\": c[\"t\"], \"ref\": c[\"ref\"],\n                        \"prio\": c[\"prio\"], \"metas\": [c[\"meta\"]]})\n    return out\n\n\ndef is_grid_cluster(cl):\n    return any(m.get(\"kind\") == \"grid\" for m in cl[\"metas\"])\n\n\ndef is_anchor_cluster(cl):\n    \"\"\"Grids and faces of reference (structural) walls are fixed anchors of a string.\"\"\"\n    return any(m.get(\"kind\") == \"grid\" or m.get(\"role\") == \"reference\" for m in cl[\"metas\"])\n\n\ndef is_opening_jamb_only(cl):\n    \"\"\"True when every reference in the cluster is a jamb of an opening (partial height).\"\"\"\n    return all(m.get(\"kind\") == \"face\" and m.get(\"wall_kind\") == \"par\" and m.get(\"partial\")\n               for m in cl[\"metas\"])\n\n\ndef overall_filter(clusters):\n    \"\"\"Keep anchors (grids, reference walls), and per interval between anchors only the\n    first and last masonry face. Opening jambs are ignored: an overall string measures\n    the walls, not the openings.\"\"\"\n    keep = []\n    group = []\n\n    def flush():\n        if group:\n            keep.append(group[0])\n            if len(group) > 1:\n                keep.append(group[-1])\n        del group[:]\n\n    for cl in clusters:\n        if is_anchor_cluster(cl):\n            flush()\n            keep.append(cl)\n        elif not is_opening_jamb_only(cl):\n            group.append(cl)\n    flush()\n    return keep\n\n\ndef find_openings(clusters, floor_z):\n    \"\"\"\n    Segment i (between cluster i and i+1) is an opening when cluster i holds a jamb\n    face of a parallel wall whose normal points forward (+1) and cluster i+1 a jamb\n    face of the same wall pointing back (-1), both with the same vertical extent and\n    lower than the wall itself. Returns {segment_index: (height, sill)}.\n    \"\"\"\n    res = {}\n    for i in range(len(clusters) - 1):\n        found = None\n        for a in clusters[i][\"metas\"]:\n            if not (a.get(\"kind\") == \"face\" and a.get(\"wall_kind\") == \"par\"\n                    and a.get(\"sign\") == 1 and a.get(\"partial\")\n                    and a.get(\"role\", \"dimension\") == \"dimension\"):\n                continue\n            for b in clusters[i + 1][\"metas\"]:\n                if (b.get(\"kind\") == \"face\" and b.get(\"wall_kind\") == \"par\"\n                        and b.get(\"sign\") == -1 and b.get(\"partial\")\n                        and b.get(\"wall\") == a.get(\"wall\")\n                        and abs(b[\"zmin\"] - a[\"zmin\"]) < Z_TOL\n                        and abs(b[\"zmax\"] - a[\"zmax\"]) < Z_TOL):\n                    found = (a[\"zmax\"] - a[\"zmin\"], a[\"zmin\"] - floor_z, a)\n                    break\n            if found:\n                break\n        if found:\n            res[i] = found\n    return res\n\n\ndef opening_text(height_txt, sill_txt, height_prefix, sill_prefix, has_sill):\n    parts = []\n    if height_prefix is not None:\n        parts.append(u\"{0}{1}\".format(height_prefix, height_txt))\n    if has_sill and sill_prefix:\n        parts.append(u\"{0}{1}\".format(sill_prefix, sill_txt))\n    return u\" \".join(parts)\n\n\ndef make_labels(raw_keys):\n    \"\"\"\n    raw_keys: iterable of (link_title_or_None, family_name, type_name).\n    Label = type name; \"[link] \" in front for linked walls; \" (family)\" behind only when\n    the same type name exists in more than one family. Returns {raw_key: label}.\n    \"\"\"\n    fams = {}\n    for link, fam, typ in raw_keys:\n        fams.setdefault((link, typ), set()).add(fam)\n    out = {}\n    for k in set(raw_keys):\n        link, fam, typ = k\n        lab = typ\n        if len(fams[(link, typ)]) > 1 and fam:\n            lab = u\"{0} ({1})\".format(typ, fam)\n        if link:\n            lab = u\"[{0}] {1}\".format(link, lab)\n        out[k] = lab\n    return out\n\n\ndef type_key(category, label):\n    return u\"{0}|{1}\".format(category, label)\n\n\ndef filter_labels(labels, query, prefix=u\"\"):\n    \"\"\"Case-insensitive search; every word of the query must appear in prefix + label.\"\"\"\n    words = [w for w in (query or u\"\").lower().split() if w]\n    if not words:\n        return list(labels)\n    return [l for l in labels if all(w in (prefix + u\" \" + l).lower() for w in words)]\n\n\ndef settings_path():\n    base = os.environ.get(\"APPDATA\") or os.path.expanduser(\"~\")\n    return os.path.join(base, \"SmartDimensions\", \"settings.json\")\n\n\ndef load_settings():\n    s = dict(DEFAULT_SETTINGS)\n    try:\n        with open(settings_path(), \"r\") as f:\n            s.update(json.load(f))\n    except Exception:\n        pass\n    return s\n\n\ndef save_settings(s):\n    try:\n        p = settings_path()\n        if not os.path.isdir(os.path.dirname(p)):\n            os.makedirs(os.path.dirname(p))\n        with open(p, \"w\") as f:\n            json.dump(s, f, indent=2)\n    except Exception:\n        pass\n\n\n# ---------------------------------------------------------------------------\n# Revit / Dynamo part\n# ---------------------------------------------------------------------------\nREVIT = True\ntry:\n    import clr\n    clr.AddReference(\"RevitAPI\")\n    clr.AddReference(\"RevitServices\")\n    clr.AddReference(\"System.Windows.Forms\")\n    clr.AddReference(\"System.Drawing\")\n    from Autodesk.Revit import DB\n    from RevitServices.Persistence import DocumentManager\n    from RevitServices.Transactions import TransactionManager\n    import System.Windows.Forms as WF\n    import System.Drawing as SD\nexcept Exception:\n    REVIT = False\n\n\ndef eid_int(eid):\n    \"\"\"ElementId as int; .Value from Revit 2024, .IntegerValue before (removed in 2026).\"\"\"\n    try:\n        return int(eid.Value)\n    except Exception:\n        return int(eid.IntegerValue)\n\n\ndef tname(obj):\n    try:\n        return obj.GetType().Name\n    except Exception:\n        return \"\"\n\n\ndef el_name(e):\n    try:\n        n = e.Name\n        if n:\n            return n\n    except Exception:\n        pass\n    try:\n        return DB.Element.Name.GetValue(e)\n    except Exception:\n        pass\n    try:\n        return e.get_Parameter(DB.BuiltInParameter.SYMBOL_NAME_PARAM).AsString()\n    except Exception:\n        return \"\"\n\n\ndef unit2(x, y):\n    l = math.hypot(x, y)\n    if l < 1e-12:\n        return None\n    return (x / l, y / l)\n\n\ndef bbox_z(elem, view=None, transform=None):\n    bb = elem.get_BoundingBox(view)\n    if bb is None:\n        return None\n    zs = []\n    for p in (bb.Min, bb.Max):\n        q = transform.OfPoint(p) if transform is not None else p\n        zs.append(q.Z)\n    return min(zs), max(zs)\n\n\ndef cut_plane_z(doc, view, floor_z):\n    \"\"\"Absolute z of the view's cut plane, based on the z of the path lines.\"\"\"\n    try:\n        vr = view.GetViewRange()\n        off = vr.GetOffset(DB.PlanViewPlane.CutPlane)\n        lvl = doc.GetElement(vr.GetLevelId(DB.PlanViewPlane.CutPlane))\n        gen = view.GenLevel\n        delta = 0.0\n        if lvl is not None and gen is not None:\n            delta = lvl.Elevation - gen.Elevation\n        return floor_z + delta + off\n    except Exception:\n        return floor_z + 1200.0 / 304.8\n\n\ndef collect_dimension_types(doc):\n    res = {}\n    for dt in DB.FilteredElementCollector(doc).OfClass(DB.DimensionType):\n        try:\n            if dt.StyleType != DB.DimensionStyleType.Linear:\n                continue\n        except Exception:\n            continue\n        n = el_name(dt)\n        if n and n not in res:\n            res[n] = dt\n    return res\n\n\ndef collect_line_styles(doc):\n    res = {}\n    cat = doc.Settings.Categories.get_Item(DB.BuiltInCategory.OST_Lines)\n    for sc in cat.SubCategories:\n        gs = sc.GetGraphicsStyle(DB.GraphicsStyleType.Projection)\n        if gs is not None:\n            res[sc.Name] = gs.Id\n    return res\n\n\ndef link_instances(doc, view):\n    out = []\n    for li in DB.FilteredElementCollector(doc, view.Id).OfClass(DB.RevitLinkInstance):\n        ldoc = li.GetLinkDocument()\n        if ldoc is not None:\n            out.append((li, ldoc))\n    return out\n\n\ndef collect_paths(doc, view, style_ids):\n    \"\"\"Straight detail/model lines in the view whose line style is one of style_ids.\"\"\"\n    paths = []\n    skipped = 0\n    for ce in DB.FilteredElementCollector(doc, view.Id).OfClass(DB.CurveElement):\n        try:\n            ls = ce.LineStyle\n        except Exception:\n            continue\n        if ls is None:\n            continue\n        sid = eid_int(ls.Id)\n        if sid not in style_ids:\n            continue\n        crv = ce.GeometryCurve\n        if tname(crv) != \"Line\":\n            skipped += 1\n            continue\n        a, b = crv.GetEndPoint(0), crv.GetEndPoint(1)\n        d = unit2(b.X - a.X, b.Y - a.Y)\n        if d is None:\n            continue\n        paths.append({\"elem\": ce, \"a\": a, \"b\": b, \"p0\": (a.X, a.Y), \"dir\": d,\n                      \"len\": math.hypot(b.X - a.X, b.Y - a.Y), \"mode\": style_ids[sid]})\n    return paths, skipped\n\n\ndef delete_dims_on_paths(doc, view, paths):\n    \"\"\"Delete dimensions whose line lies on one of the path lines (a previous run).\"\"\"\n    ids = {}\n    for dim in DB.FilteredElementCollector(doc, view.Id).OfClass(DB.Dimension):\n        try:\n            crv = dim.Curve\n            if crv is None or tname(crv) != \"Line\":\n                continue\n            dd = crv.Direction\n            org = crv.Origin\n            dorg = dim.Origin\n        except Exception:\n            continue\n        for p in paths:\n            d = p[\"dir\"]\n            if abs(d[0] * dd.Y - d[1] * dd.X) > 1e-6:\n                continue\n            vx, vy = org.X - p[\"p0\"][0], org.Y - p[\"p0\"][1]\n            if abs(vx * d[1] - vy * d[0]) > 1e-4:\n                continue\n            t = (dorg.X - p[\"p0\"][0]) * d[0] + (dorg.Y - p[\"p0\"][1]) * d[1]\n            if -MERGE_TOL <= t <= p[\"len\"] + MERGE_TOL:\n                ids[eid_int(dim.Id)] = dim.Id\n                break\n    n = 0\n    for i in ids.values():\n        try:\n            doc.Delete(i)\n            n += 1\n        except Exception:\n            pass\n    return n\n\n\ndef bic_ints(names):\n    out = set()\n    for n in names:\n        try:\n            out.add(int(getattr(DB.BuiltInCategory, n)))\n        except Exception:\n            pass\n    return out\n\n\n# Categories that give line references (unbounded vertical planes seen as lines in plan).\nLINE_CATEGORIES = [\"OST_Grids\", \"OST_CLines\"]\n# Model categories that make no sense as dimension targets.\nEXCLUDED_CATEGORIES = [\n    \"OST_Rooms\", \"OST_Areas\", \"OST_MEPSpaces\", \"OST_Lines\", \"OST_RvtLinks\", \"OST_Cameras\",\n    \"OST_IOSModelGroups\", \"OST_SketchLines\", \"OST_RoomSeparationLines\", \"OST_AreaSchemeLines\",\n    \"OST_MEPSpaceSeparationLines\", \"OST_SectionBox\", \"OST_VolumeOfInterest\", \"OST_PointClouds\",\n    \"OST_DetailComponents\", \"OST_Entourage\", \"OST_Planting\", \"OST_Topography\", \"OST_Toposolid\",\n    \"OST_Site\", \"OST_Parking\", \"OST_RoomTags\", \"OST_Viewers\", \"OST_Levels\",\n    \"OST_ProjectBasePoint\", \"OST_SharedBasePoint\", \"OST_InternalOriginSurveyPoint\",\n]\n\n\ndef element_kind(e):\n    \"\"\"\n    line   grids, reference planes: one line reference\n    wall   walls: faces, ends, openings (perpendicular / parallel rules)\n    family loadable families (columns, beams, doors, equipment): outer faces only\n    host   other model elements (floors, roofs, foundations, ...): faces the line crosses\n    \"\"\"\n    n = tname(e)\n    if n in (\"Grid\", \"ReferencePlane\"):\n        return \"line\"\n    if n == \"Wall\":\n        return \"wall\"\n    if n == \"FamilyInstance\":\n        return \"family\"\n    return \"host\"\n\n\ndef type_raw_key(e, edoc, link_title):\n    \"\"\"(link, family, type label) used for the label in the selector.\"\"\"\n    if tname(e) == \"ReferencePlane\":\n        n = e.Name\n        return (link_title, \"\", n if n else \"(unnamed reference planes)\")\n    t = None\n    try:\n        tid = e.GetTypeId()\n        if tid is not None and eid_int(tid) > 0:\n            t = edoc.GetElement(tid)\n    except Exception:\n        t = None\n    if t is None:\n        return (link_title, \"\", \"(no type)\")\n    fam = \"\"\n    try:\n        fam = t.FamilyName or \"\"\n    except Exception:\n        pass\n    if tname(t) == \"FamilySymbol\":\n        # Loadable family types: \"Family : Type\" (type names alone are ambiguous).\n        return (link_title, \"\", u\"{0} : {1}\".format(fam, el_name(t)) if fam else el_name(t))\n    return (link_title, fam, el_name(t))\n\n\nclass Picker(object):\n    \"\"\"Decides which elements of a document can appear in the selector.\"\"\"\n\n    def __init__(self):\n        self.line_cats = bic_ints(LINE_CATEGORIES)\n        self.excluded = bic_ints(EXCLUDED_CATEGORIES)\n\n    def accept(self, e):\n        try:\n            cat = e.Category\n        except Exception:\n            return None\n        if cat is None:\n            return None\n        cid = eid_int(cat.Id)\n        if cid in self.line_cats:\n            return cat.Name\n        if cid in self.excluded or cid > 0:\n            return None\n        if cat.Name.startswith(\"<\"):\n            return None\n        try:\n            if cat.CategoryType != DB.CategoryType.Model:\n                return None\n        except Exception:\n            return None\n        # Nested shared components are dimensioned through their parent.\n        try:\n            if e.SuperComponent is not None:\n                return None\n        except Exception:\n            pass\n        return cat.Name\n\n\ndef view_outline_for_link(view, inv_tf, zr):\n    \"\"\"Outline (in link coordinates) of the crop box + view z range, or None for no XY limit.\"\"\"\n    pts = []\n    big = 1.0e5\n    try:\n        if view.CropBoxActive:\n            cb = view.CropBox\n            for x in (cb.Min.X, cb.Max.X):\n                for y in (cb.Min.Y, cb.Max.Y):\n                    pts.append(cb.Transform.OfPoint(DB.XYZ(x, y, 0)))\n    except Exception:\n        pts = []\n    if not pts:\n        pts = [DB.XYZ(-big, -big, 0), DB.XYZ(big, big, 0)]\n    corners = []\n    for p in pts:\n        for z in zr:\n            corners.append(inv_tf.OfPoint(DB.XYZ(p.X, p.Y, z)))\n    mn = DB.XYZ(min(c.X for c in corners), min(c.Y for c in corners), min(c.Z for c in corners))\n    mx = DB.XYZ(max(c.X for c in corners), max(c.Y for c in corners), max(c.Z for c in corners))\n    return DB.Outline(mn, mx)\n\n\ndef view_z_range(doc, view, floor_z):\n    \"\"\"(bottom, top) of the view range in model z, relative to the given floor z.\"\"\"\n    def plane_z(plane, default):\n        try:\n            vr = view.GetViewRange()\n            lid = vr.GetLevelId(plane)\n            if lid is None or eid_int(lid) < 0:\n                return default\n            lvl = doc.GetElement(lid)\n            gen = view.GenLevel\n            return floor_z + (lvl.Elevation - gen.Elevation) + vr.GetOffset(plane)\n        except Exception:\n            return default\n    bottom = plane_z(DB.PlanViewPlane.ViewDepthPlane, floor_z - 3.0)\n    top = plane_z(DB.PlanViewPlane.TopClipPlane, floor_z + 15.0)\n    return min(bottom, top), max(bottom, top)\n\n\ndef collect_entries(doc, view, floor_guess):\n    \"\"\"\n    Every selectable element in the view, host and linked.\n    Returns list of dicts {cat, label, elem, edoc, li, tf, kind}.\n    \"\"\"\n    picker = Picker()\n    raw = []\n    for e in DB.FilteredElementCollector(doc, view.Id).WhereElementIsNotElementType():\n        cat = picker.accept(e)\n        if cat is None:\n            continue\n        raw.append((cat, type_raw_key(e, doc, None), e, doc, None, None))\n    zr = view_z_range(doc, view, floor_guess)\n    for li, ldoc in link_instances(doc, view):\n        tf = li.GetTotalTransform()\n        title = ldoc.Title\n        col = DB.FilteredElementCollector(ldoc).WhereElementIsNotElementType()\n        try:\n            col = col.WherePasses(DB.BoundingBoxIntersectsFilter(view_outline_for_link(view, tf.Inverse, zr)))\n        except Exception:\n            pass\n        for e in col:\n            cat = picker.accept(e)\n            if cat is None:\n                continue\n            raw.append((cat, type_raw_key(e, ldoc, title), e, ldoc, li, tf))\n    labels = {}\n    by_cat = {}\n    for cat, k, _, _, _, _ in raw:\n        by_cat.setdefault(cat, []).append(k)\n    for cat, keys in by_cat.items():\n        lab = make_labels(keys)\n        for k, v in lab.items():\n            labels[(cat, k)] = v\n    return [{\"cat\": cat, \"label\": labels[(cat, k)], \"elem\": e, \"edoc\": ed, \"li\": li, \"tf\": tf,\n             \"kind\": element_kind(e)} for cat, k, e, ed, li, tf in raw]\n\n\ndef iter_solids(geom):\n    for g in geom:\n        n = tname(g)\n        if n == \"Solid\":\n            try:\n                if g.Volume > 0 and g.Faces.Size > 0:\n                    yield g\n            except Exception:\n                pass\n        elif n == \"GeometryInstance\":\n            for s in iter_solids(g.GetInstanceGeometry()):\n                yield s\n\n\ndef compose(a, b):\n    \"\"\"Transform a applied after b (either may be None).\"\"\"\n    if a is None:\n        return b\n    if b is None:\n        return a\n    return a.Multiply(b)\n\n\ndef face_record(face, xf, ref):\n    \"\"\"Vertical planar face -> dict, or (None, zmin, zmax) info for non-vertical faces.\"\"\"\n    bb = face.GetBoundingBox()\n    nrm = face.ComputeNormal(DB.UV((bb.Min.U + bb.Max.U) / 2.0, (bb.Min.V + bb.Max.V) / 2.0))\n    if xf is not None:\n        nrm = xf.OfVector(nrm)\n    pts = []\n    for loop in face.EdgeLoops:\n        for edge in loop:\n            for p in edge.Tessellate():\n                pts.append(xf.OfPoint(p) if xf is not None else p)\n    if not pts:\n        return None, None, None\n    fz0 = min(p.Z for p in pts)\n    fz1 = max(p.Z for p in pts)\n    if abs(nrm.Z) > 0.01:\n        return None, fz0, fz1\n    n2 = unit2(nrm.X, nrm.Y)\n    if n2 is None:\n        return None, fz0, fz1\n    u = (-n2[1], n2[0])\n    us = [u[0] * p.X + u[1] * p.Y for p in pts]\n    xs = [p.X for p in pts]\n    ys = [p.Y for p in pts]\n    return ({\"n\": n2, \"c\": n2[0] * pts[0].X + n2[1] * pts[0].Y,\n             \"umin\": min(us), \"umax\": max(us), \"zmin\": fz0, \"zmax\": fz1, \"ref\": ref,\n             \"xy\": (min(xs), min(ys), max(xs), max(ys))}, fz0, fz1)\n\n\ndef element_faces(entry, opts, warnings):\n    \"\"\"\n    Vertical planar faces of an element with references usable in a dimension.\n    Family instance geometry comes as symbol geometry; its references are rebuilt as\n    instance references through their stable representation.\n    \"\"\"\n    e, edoc, li, tf = entry[\"elem\"], entry[\"edoc\"], entry[\"li\"], entry[\"tf\"]\n    geom = e.get_Geometry(opts)\n    if geom is None:\n        return [], None, None\n    faces = []\n    zmin, zmax = 1e9, -1e9\n\n    def add(face, xf, ref):\n        rec, z0, z1 = face_record(face, xf, ref)\n        if z0 is not None:\n            zs[0] = min(zs[0], z0)\n            zs[1] = max(zs[1], z1)\n        if rec is None or ref is None:\n            return\n        if li is not None:\n            try:\n                rec[\"ref\"] = ref.CreateLinkReference(li)\n            except Exception:\n                warnings[\"linkref\"] = warnings.get(\"linkref\", 0) + 1\n                return\n        faces.append(rec)\n\n    zs = [zmin, zmax]\n    for g in geom:\n        n = tname(g)\n        if n == \"Solid\":\n            try:\n                if g.Volume <= 0:\n                    continue\n            except Exception:\n                continue\n            for face in g.Faces:\n                if tname(face) == \"PlanarFace\":\n                    add(face, tf, face.Reference)\n        elif n == \"GeometryInstance\":\n            xf = compose(tf, g.Transform)\n            for sg in g.GetSymbolGeometry():\n                if tname(sg) != \"Solid\":\n                    continue\n                try:\n                    if sg.Volume <= 0:\n                        continue\n                except Exception:\n                    continue\n                for face in sg.Faces:\n                    if tname(face) != \"PlanarFace\" or face.Reference is None:\n                        continue\n                    ref = None\n                    try:\n                        stable = face.Reference.ConvertToStableRepresentation(edoc)\n                        ref = DB.Reference.ParseFromStableRepresentation(\n                            edoc, u\"{0}:0:INSTANCE:{1}\".format(e.UniqueId, stable))\n                    except Exception:\n                        warnings[\"instref\"] = warnings.get(\"instref\", 0) + 1\n                    add(face, xf, ref)\n    return faces, zs[0], zs[1]\n\n\ndef line_record(entry):\n    e, li, tf = entry[\"elem\"], entry[\"li\"], entry[\"tf\"]\n    if tname(e) == \"Grid\":\n        crv = e.Curve\n        if tname(crv) != \"Line\":\n            return None\n        a, b = crv.GetEndPoint(0), crv.GetEndPoint(1)\n        ref = DB.Reference(e)\n    else:\n        try:\n            if abs(e.Normal.Z) > 0.01:\n                return None\n        except Exception:\n            return None\n        a, b = e.BubbleEnd, e.FreeEnd\n        ref = e.GetReference()\n    if tf is not None:\n        a, b = tf.OfPoint(a), tf.OfPoint(b)\n    d = unit2(b.X - a.X, b.Y - a.Y)\n    if d is None or ref is None:\n        return None\n    if li is not None:\n        try:\n            ref = ref.CreateLinkReference(li)\n        except Exception:\n            return None\n    return {\"type\": \"line\", \"p0\": (a.X, a.Y), \"dir\": d, \"ref\": ref, \"role\": entry[\"role\"],\n            \"linked\": li is not None}\n\n\ndef bbox_xy(entry):\n    bb = entry[\"elem\"].get_BoundingBox(None)\n    if bb is None:\n        return None\n    tf = entry[\"tf\"]\n    pts = []\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            p = DB.XYZ(x, y, bb.Min.Z)\n            pts.append(tf.OfPoint(p) if tf is not None else p)\n    return (min(p.X for p in pts), min(p.Y for p in pts), max(p.X for p in pts), max(p.Y for p in pts))\n\n\ndef rects_overlap(a, b):\n    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])\n\n\ndef path_rect(p, margin):\n    xs = (p[\"a\"].X, p[\"b\"].X)\n    ys = (p[\"a\"].Y, p[\"b\"].Y)\n    return (min(xs) - margin, min(ys) - margin, max(xs) + margin, max(ys) + margin)\n\n\ndef build_records(entries, view, paths, cut_z, zr, sdist, warnings):\n    \"\"\"Geometry records for the ticked elements that lie near at least one path line.\"\"\"\n    opts_host = DB.Options()\n    opts_host.ComputeReferences = True\n    # No view here: view-specific geometry of a plan is clipped at the cut plane, which\n    # made opening heights run from the sill to the cut plane only.\n    opts_host.DetailLevel = view.DetailLevel\n    opts_link = DB.Options()\n    opts_link.ComputeReferences = True\n    opts_link.DetailLevel = view.DetailLevel\n    rects = [path_rect(p, sdist + 1.0) for p in paths]\n    recs = []\n    for en in entries:\n        if en[\"kind\"] == \"line\":\n            r = line_record(en)\n            if r is not None:\n                recs.append(r)\n            continue\n        xy = bbox_xy(en)\n        if xy is None or not any(rects_overlap(xy, r) for r in rects):\n            continue\n        z = bbox_z(en[\"elem\"], None, en[\"tf\"])\n        if z is None:\n            continue\n        if en[\"kind\"] == \"wall\":\n            # A wall only counts when the plan cuts it.\n            if not (z[0] - Z_TOL <= cut_z <= z[1] + Z_TOL):\n                continue\n        elif z[1] < zr[0] or z[0] > zr[1]:\n            continue\n        wdir = None\n        if en[\"kind\"] == \"wall\":\n            crv = getattr(en[\"elem\"].Location, \"Curve\", None)\n            if crv is None or tname(crv) != \"Line\":\n                warnings[\"curved\"] = warnings.get(\"curved\", 0) + 1\n                continue\n            a, b = crv.GetEndPoint(0), crv.GetEndPoint(1)\n            if en[\"tf\"] is not None:\n                a, b = en[\"tf\"].OfPoint(a), en[\"tf\"].OfPoint(b)\n            wdir = unit2(b.X - a.X, b.Y - a.Y)\n            if wdir is None:\n                continue\n        faces, zmin, zmax = element_faces(en, opts_link if en[\"li\"] is not None else opts_host, warnings)\n        if not faces:\n            continue\n        key = (eid_int(en[\"li\"].Id) if en[\"li\"] is not None else -1, eid_int(en[\"elem\"].Id))\n        recs.append({\"type\": en[\"kind\"], \"key\": key, \"dir\": wdir, \"zmin\": zmin, \"zmax\": zmax,\n                     \"faces\": faces, \"linked\": en[\"li\"] is not None, \"role\": en[\"role\"],\n                     \"elem\": en[\"elem\"],\n                     \"cat\": en[\"cat\"]})\n    return recs\n\n\ndef build_candidates(path, recs, settings):\n    cands = []\n    p0, d, L = path[\"p0\"], path[\"dir\"], path[\"len\"]\n    sdist = settings[\"search_distance_cm\"] * FT_PER_CM\n    for r in recs:\n        role = r[\"role\"]\n        if r[\"type\"] == \"line\":\n            t = grid_hit(r[\"p0\"], r[\"dir\"], p0, d, L)\n            if t is not None:\n                cands.append({\"t\": t, \"ref\": r[\"ref\"], \"prio\": PRIO_GRID,\n                              \"meta\": {\"kind\": \"grid\", \"role\": role}})\n            continue\n        if r[\"type\"] == \"wall\":\n            kind = classify_wall(r[\"dir\"], d)\n            if kind is None:\n                continue\n        elif r[\"type\"] == \"family\":\n            kind = \"near\"\n        else:\n            kind = \"perp\"\n        full_h = r[\"zmax\"] - r[\"zmin\"]\n        start = len(cands)\n        for f in r[\"faces\"]:\n            hit = face_hit(f, p0, d, L, kind, sdist)\n            if hit is None:\n                continue\n            t, sign = hit\n            partial = (f[\"zmax\"] - f[\"zmin\"]) < full_h - 10 * Z_TOL\n            if role == \"reference\":\n                prio = PRIO_REF_FACE\n            else:\n                prio = PRIO_LINK_FACE if r[\"linked\"] else PRIO_HOST_FACE\n            cands.append({\"t\": t, \"ref\": f[\"ref\"], \"prio\": prio,\n                          \"meta\": {\"kind\": \"face\", \"wall\": r[\"key\"], \"role\": role,\n                                   \"wall_kind\": kind if r[\"type\"] == \"wall\" else \"other\",\n                                   \"sign\": sign, \"partial\": partial,\n                                   \"zmin\": f[\"zmin\"], \"zmax\": f[\"zmax\"]}})\n        if r[\"type\"] == \"family\" and len(cands) - start > 2:\n            # A family contributes its outline only (first and last face along the line),\n            # not every face of a frame, leaf or handle.\n            mine = cands[start:]\n            del cands[start:]\n            cands.append(min(mine, key=lambda c: c[\"t\"]))\n            cands.append(max(mine, key=lambda c: c[\"t\"]))\n    return cands\n\n\ndef fmt_len(doc, v, dim_type=None):\n    \"\"\"Format a length like the dimension type does (falls back to project units).\"\"\"\n    try:\n        if dim_type is not None:\n            fo = dim_type.GetUnitsFormatOptions()\n            if fo is not None and not fo.UseDefault:\n                fvo = DB.FormatValueOptions()\n                fvo.SetFormatOptions(fo)\n                return DB.UnitFormatUtils.Format(doc.GetUnits(), DB.SpecTypeId.Length, v, False, fvo)\n    except Exception:\n        pass\n    try:\n        return DB.UnitFormatUtils.Format(doc.GetUnits(), DB.SpecTypeId.Length, v, False)\n    except Exception:\n        return u\"{0:.1f}\".format(v * 30.48)\n\n\ndef cm(v):\n    return u\"{0:.1f}\".format(v * 30.48)\n\n\ndef opening_debug(doc, path, meta, rec_by_key):\n    \"\"\"One report line per labelled opening, all values in cm relative to the path line z.\"\"\"\n    z0 = path[\"a\"].Z\n    key = meta.get(\"wall\")\n    rec = rec_by_key.get(key)\n    line = u\"  wall {0}: jamb z {1} to {2}\".format(key[1], cm(meta[\"zmin\"] - z0), cm(meta[\"zmax\"] - z0))\n    if rec is not None:\n        line += u\"; wall z {0} to {1}\".format(cm(rec[\"zmin\"] - z0), cm(rec[\"zmax\"] - z0))\n    if key[0] == -1:\n        wall = rec.get(\"elem\") if rec is not None else None\n        if wall is not None:\n            try:\n                for iid in wall.FindInserts(True, False, False, False):\n                    ins = doc.GetElement(iid)\n                    hp = ins.get_Parameter(DB.BuiltInParameter.INSTANCE_HEAD_HEIGHT_PARAM)\n                    sp = ins.get_Parameter(DB.BuiltInParameter.INSTANCE_SILL_HEIGHT_PARAM)\n                    line += u\"; insert {0} '{1}' sill {2} head {3}\".format(\n                        eid_int(iid), el_name(ins),\n                        cm(sp.AsDouble()) if sp is not None else \"?\",\n                        cm(hp.AsDouble()) if hp is not None else \"?\")\n            except Exception:\n                pass\n    return line\n\n\ndef place_dimension(doc, view, path, clusters, dim_type, settings, report):\n    ra = DB.ReferenceArray()\n    for cl in clusters:\n        ra.Append(cl[\"ref\"])\n    line = DB.Line.CreateBound(path[\"a\"], path[\"b\"])\n    dim = doc.Create.NewDimension(view, line, ra, dim_type)\n    if dim is None:\n        raise Exception(\"Revit returned no dimension\")\n    small = 0\n    openings = {}\n    if settings[\"opening_text\"] and path[\"mode\"] == \"detail\":\n        openings = find_openings(clusters, path[\"a\"].Z)\n    p0, d = path[\"p0\"], path[\"dir\"]\n    starts = [cl[\"t\"] for cl in clusters]\n\n    def seg_index(origin):\n        t = (origin.X - p0[0]) * d[0] + (origin.Y - p0[1]) * d[1]\n        for i in range(len(starts) - 1):\n            if starts[i] - MERGE_TOL <= t <= starts[i + 1] + MERGE_TOL:\n                return i\n        return None\n\n    def label(i):\n        h, sill = openings[i][0], openings[i][1]\n        return opening_text(fmt_len(doc, h, dim_type), fmt_len(doc, sill, dim_type), settings[\"height_prefix\"],\n                            settings[\"sill_prefix\"], sill > 10 * Z_TOL)\n\n    if dim.NumberOfSegments == 0:\n        if 0 in openings:\n            dim.Below = label(0)\n        v = dim.Value\n        if v is not None and v < SMALL_SEGMENT:\n            small += 1\n    else:\n        for seg in dim.Segments:\n            v = seg.Value\n            if v is not None and v < SMALL_SEGMENT:\n                small += 1\n            i = seg_index(seg.Origin)\n            if i is not None and i in openings:\n                seg.Below = label(i)\n    report[\"openings\"] += len(openings)\n    for i in sorted(openings):\n        report[\"opening_lines\"].append(opening_debug(doc, path, openings[i][2], report[\"recs\"]))\n    report[\"small\"] += small\n    return dim\n\n\n# ---------------------------------------------------------------------------\n# Dialog\n# ---------------------------------------------------------------------------\ndef show_dialog(dim_type_names, style_names, tree_data, s):\n    \"\"\"\n    tree_data: {category: {label: count}}.\n    Resizable dialog. Returns the new settings dict, or None when cancelled.\n    \"\"\"\n    form = WF.Form()\n    form.Text = \"Smart Dimensions\"\n    form.StartPosition = WF.FormStartPosition.CenterScreen\n    form.FormBorderStyle = WF.FormBorderStyle.Sizable\n    form.MaximizeBox = True\n    form.MinimizeBox = False\n    form.Font = SD.Font(\"Segoe UI\", 9)\n    BW, BH = 600, 820                     # design size; anchors scale from here\n    form.ClientSize = SD.Size(BW, BH)\n    form.MinimumSize = SD.Size(480, 640)\n    W, H = BW, BH\n    try:\n        W, H = int(s.get(\"dialog_size\", [BW, BH])[0]), int(s.get(\"dialog_size\", [BW, BH])[1])\n    except Exception:\n        pass\n\n    A = WF.AnchorStyles\n    TLR = A.Top | A.Left | A.Right\n    BR = A.Bottom | A.Right\n    BLR = A.Bottom | A.Left | A.Right\n    ALL = A.Top | A.Bottom | A.Left | A.Right\n    x0, cw = 12, BW - 24\n    y = [10]\n\n    def place(parent, ctrl, x, yy, w, h, anchor):\n        ctrl.Location = SD.Point(x, yy)\n        ctrl.Size = SD.Size(w, h)\n        ctrl.Anchor = anchor\n        parent.Controls.Add(ctrl)\n        return ctrl\n\n    def top_label(text):\n        l = WF.Label()\n        l.Text = text\n        place(form, l, x0, y[0], cw, 18, TLR)\n        y[0] += 20\n\n    def top_combo(items, current):\n        c = WF.ComboBox()\n        c.DropDownStyle = WF.ComboBoxStyle.DropDownList\n        for it in items:\n            c.Items.Add(it)\n        if current in items:\n            c.SelectedIndex = items.index(current)\n        elif items:\n            c.SelectedIndex = 0\n        place(form, c, x0, y[0], cw, 24, TLR)\n        y[0] += 32\n        return c\n\n    top_label(\"Dimension type\")\n    cb_dim = top_combo(dim_type_names, s[\"dimension_type\"])\n    top_label(\"Path line style for detailed strings\")\n    cb_detail = top_combo(style_names, s[\"detail_style\"])\n    none_item = \"<none>\"\n    top_label(\"Path line style for overall strings (anchors + outer faces only; must differ from detailed)\")\n    cb_overall = top_combo([none_item] + style_names, s[\"overall_style\"] or none_item)\n\n    # ---- bottom block, built upwards from the bottom edge\n    bottom = BH - 12\n    btn_cancel = WF.Button()\n    btn_cancel.Text = \"Cancel\"\n    btn_cancel.DialogResult = WF.DialogResult.Cancel\n    place(form, btn_cancel, x0 + cw - 100, bottom - 30, 100, 30, BR)\n    btn_ok = WF.Button()\n    btn_ok.Text = \"Place dimensions\"\n    btn_ok.DialogResult = WF.DialogResult.OK\n    place(form, btn_ok, x0 + cw - 250, bottom - 30, 140, 30, BR)\n    form.AcceptButton = btn_ok\n    form.CancelButton = btn_cancel\n    yb = [bottom - 44]\n\n    def field(text, val, width=90):\n        yb[0] -= 28\n        l = WF.Label()\n        l.Text = text\n        place(form, l, x0, yb[0] + 3, cw - width - 10, 18, BLR)\n        t = WF.TextBox()\n        t.Text = u\"{0}\".format(val)\n        place(form, t, x0 + cw - width, yb[0], width, 24, BR)\n        return t\n\n    def check(text, val):\n        yb[0] -= 24\n        c = WF.CheckBox()\n        c.Text = text\n        c.Checked = bool(val)\n        place(form, c, x0, yb[0], cw, 22, BLR)\n        return c\n\n    tb_sp = field(\"Sill height prefix (empty = no sill height)\", s[\"sill_prefix\"])\n    tb_hp = field(\"Height prefix\", s[\"height_prefix\"])\n    chk_open = check(\"Write opening height below wall opening segments\", s[\"opening_text\"])\n    chk_report = check(\"Debug: show a report after placing\", s.get(\"debug\", False))\n    chk_replace = check(\"Replace dimensions that already lie on the path lines\", s[\"replace_existing\"])\n    tb_dist = field(\"Search distance for parallel walls and families (cm)\", s[\"search_distance_cm\"])\n\n    # ---- category / type trees in two tabs\n    tabs = WF.TabControl()\n    place(form, tabs, x0, y[0] + 4, cw, yb[0] - y[0] - 12, ALL)\n    cats = sorted(tree_data.keys(), key=lambda c: c.lower())\n\n    links = {}   # title -> state of each tab, so a tab can see what the other one ticked\n\n    def tree_tab(title, hint, saved, other_title):\n        page = WF.TabPage()\n        page.Text = title\n        tabs.TabPages.Add(page)\n        pw = cw - 8\n        tv = WF.TreeView()\n        tv.CheckBoxes = True\n        tv.HideSelection = False\n        tv.Dock = WF.DockStyle.Fill\n        page.Controls.Add(tv)\n        # Build the header completely before docking it, so anchors are computed against\n        # its real width (a TabPage is still tiny at this point).\n        head = WF.Panel()\n        head.Size = SD.Size(pw, 86)\n        hint_l = WF.Label()\n        hint_l.Text = hint\n        place(head, hint_l, 2, 4, pw - 4, 18, TLR)\n        tb = WF.TextBox()\n        place(head, tb, 2, 26, pw - 6, 24, TLR)\n        # Second row: auto-sized controls in a flow panel, so text never gets clipped\n        # at higher Windows display scaling.\n        row = WF.FlowLayoutPanel()\n        row.FlowDirection = WF.FlowDirection.LeftToRight\n        row.WrapContents = False\n        place(head, row, 0, 52, pw, 32, TLR)\n        only = WF.CheckBox()\n        only.Text = \"Show ticked only\"\n        only.AutoSize = True\n        only.Margin = WF.Padding(3, 7, 12, 3)\n        row.Controls.Add(only)\n        b_all = WF.Button()\n        b_all.Text = \"Tick shown\"\n        b_all.AutoSize = True\n        row.Controls.Add(b_all)\n        b_none = WF.Button()\n        b_none.Text = \"Untick shown\"\n        b_none.AutoSize = True\n        row.Controls.Add(b_none)\n        head.Dock = WF.DockStyle.Top\n        page.Controls.Add(head)\n        cnt = WF.Label()\n        cnt.Dock = WF.DockStyle.Bottom\n        cnt.Height = 20\n        page.Controls.Add(cnt)\n        tv.BringToFront()\n\n        checked = {}\n        for c in cats:\n            for l in tree_data[c]:\n                checked[type_key(c, l)] = type_key(c, l) in saved\n        st = {\"busy\": False, \"shown\": []}\n\n        def blocked(k):\n            \"\"\"A type ticked in the other tab cannot be ticked here.\"\"\"\n            o = links.get(other_title)\n            return bool(o and o[\"checked\"].get(k))\n\n        def count_text():\n            n = sum(1 for v in checked.values() if v)\n            cnt.Text = \"{0} of {1} types ticked\".format(n, len(checked))\n\n        def rebuild():\n            st[\"busy\"] = True\n            tv.BeginUpdate()\n            tv.Nodes.Clear()\n            shown = []\n            for c in cats:\n                labels = filter_labels(sorted(tree_data[c].keys(), key=lambda x: x.lower()),\n                                       tb.Text, prefix=c)\n                if only.Checked:\n                    labels = [l for l in labels if checked[type_key(c, l)]]\n                if not labels:\n                    continue\n                cn = tv.Nodes.Add(u\"{0}   ({1})\".format(c, len(tree_data[c])))\n                cn.Tag = u\"CAT|\" + c\n                for l in labels:\n                    k = type_key(c, l)\n                    if blocked(k):\n                        checked[k] = False\n                        tn = cn.Nodes.Add(u\"{0}   ({1})   - used in {2}\".format(l, tree_data[c][l], other_title))\n                        tn.ForeColor = SD.Color.Gray\n                    else:\n                        tn = cn.Nodes.Add(u\"{0}   ({1})\".format(l, tree_data[c][l]))\n                        shown.append(k)\n                    tn.Tag = k\n                    tn.Checked = checked[k]\n                free = [type_key(c, l) for l in labels if not blocked(type_key(c, l))]\n                cn.Checked = bool(free) and all(checked[k] for k in free)\n                if tb.Text.strip() or only.Checked or any(checked[type_key(c, l)] for l in labels):\n                    cn.Expand()\n            st[\"shown\"] = shown\n            tv.EndUpdate()\n            st[\"busy\"] = False\n            count_text()\n\n        def before_check(sender, e):\n            if st[\"busy\"]:\n                return\n            tag = u\"{0}\".format(e.Node.Tag)\n            if not tag.startswith(u\"CAT|\") and blocked(tag):\n                e.Cancel = True\n\n        def after_check(sender, e):\n            if st[\"busy\"]:\n                return\n            node = e.Node\n            tag = u\"{0}\".format(node.Tag)\n            st[\"busy\"] = True\n            try:\n                if tag.startswith(u\"CAT|\"):\n                    for ch in node.Nodes:\n                        k = u\"{0}\".format(ch.Tag)\n                        if blocked(k):\n                            continue\n                        ch.Checked = node.Checked\n                        checked[k] = bool(node.Checked)\n                else:\n                    checked[tag] = bool(node.Checked)\n                    par = node.Parent\n                    if par is not None:\n                        free = [ch for ch in par.Nodes if not blocked(u\"{0}\".format(ch.Tag))]\n                        par.Checked = bool(free) and all(ch.Checked for ch in free)\n            finally:\n                st[\"busy\"] = False\n            count_text()\n\n        def set_shown(val):\n            for k in st[\"shown\"]:\n                checked[k] = val\n            rebuild()\n\n        tv.BeforeCheck += before_check\n        tv.AfterCheck += after_check\n        tb.TextChanged += lambda sender, e: rebuild()\n        only.CheckedChanged += lambda sender, e: rebuild()\n        b_all.Click += lambda sender, e: set_shown(True)\n        b_none.Click += lambda sender, e: set_shown(False)\n        links[title] = {\"checked\": checked, \"rebuild\": rebuild}\n        return checked\n\n    # A type belongs to one tab only; old settings with a type in both keep it as Reference.\n    ref_saved = set(s[\"ref_types\"])\n    dim_saved = set(s[\"dim_types\"]) - ref_saved\n    dim_checked = tree_tab(\"Dimension\", \"Elements to dimension (walls also give openings and opening heights).\",\n                           dim_saved, \"Reference\")\n    ref_checked = tree_tab(\"Reference\", \"Fixed references, like grids and structural walls (anchors of a string).\",\n                           ref_saved, \"Dimension\")\n    for t in links.values():\n        t[\"rebuild\"]()\n    tabs.SelectedIndexChanged += lambda sender, e: [t[\"rebuild\"]() for t in links.values()]\n\n    form.ClientSize = SD.Size(max(W, 480), max(H, 600))\n    result = form.ShowDialog()\n    size = [form.ClientSize.Width, form.ClientSize.Height]\n    if result != WF.DialogResult.OK:\n        return None\n\n    try:\n        dist = float(tb_dist.Text.replace(\",\", \".\"))\n    except Exception:\n        dist = DEFAULT_SETTINGS[\"search_distance_cm\"]\n    overall = cb_overall.SelectedItem\n\n    def merged(checked, saved):\n        # keep saved ticks of types that are not in this view\n        return sorted(set([k for k, v in checked.items() if v] + [k for k in saved if k not in checked]))\n\n    out = dict(s)\n    out.update({\n        \"dimension_type\": cb_dim.SelectedItem,\n        \"detail_style\": cb_detail.SelectedItem,\n        \"overall_style\": \"\" if overall in (None, none_item) else overall,\n        \"dim_types\": merged(dim_checked, s[\"dim_types\"]),\n        \"ref_types\": merged(ref_checked, s[\"ref_types\"]),\n        \"search_distance_cm\": dist,\n        \"replace_existing\": bool(chk_replace.Checked),\n        \"debug\": bool(chk_report.Checked),\n        \"opening_text\": bool(chk_open.Checked),\n        \"height_prefix\": tb_hp.Text,\n        \"sill_prefix\": tb_sp.Text,\n        \"dialog_size\": size,\n    })\n    out[\"_dim_now\"] = [k for k, v in dim_checked.items() if v]\n    out[\"_ref_now\"] = [k for k, v in ref_checked.items() if v]\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Main\n# ---------------------------------------------------------------------------\ndef main():\n    doc = DocumentManager.Instance.CurrentDBDocument\n    view = doc.ActiveView\n    if tname(view) != \"ViewPlan\":\n        return \"Open a floor plan view and run again (active view: {0}).\".format(view.Name)\n\n    s = load_settings()\n    dim_types = collect_dimension_types(doc)\n    styles = collect_line_styles(doc)\n    if not dim_types:\n        return \"No linear dimension types found in the model.\"\n\n    # ProjectElevation is in the same coordinates as the geometry; the real floor z\n    # is taken from the path lines after the dialog.\n    floor_guess = view.GenLevel.ProjectElevation if view.GenLevel is not None else 0.0\n    entries = collect_entries(doc, view, floor_guess)\n    tree = {}\n    for en in entries:\n        d = tree.setdefault(en[\"cat\"], {})\n        d[en[\"label\"]] = d.get(en[\"label\"], 0) + 1\n    if not s.get(\"dim_types\") and not s.get(\"ref_types\"):\n        # First run: grids as references, like a drafter would.\n        grid_cat = None\n        for en in entries:\n            if tname(en[\"elem\"]) == \"Grid\":\n                grid_cat = en[\"cat\"]\n                break\n        if grid_cat:\n            s[\"ref_types\"] = [type_key(grid_cat, l) for l in tree.get(grid_cat, {})]\n\n    res = show_dialog(sorted(dim_types.keys(), key=lambda x: x.lower()),\n                      sorted(styles.keys(), key=lambda x: x.lower()), tree, s)\n    if res is None:\n        return \"Cancelled.\"\n    dim_now = set(res.pop(\"_dim_now\"))\n    ref_now = set(res.pop(\"_ref_now\"))\n    notes = []\n    if res[\"overall_style\"] and res[\"overall_style\"] == res[\"detail_style\"]:\n        # Same style for both would turn every string into an overall string.\n        res[\"overall_style\"] = \"\"\n        notes.append(\"Overall style was the same as the detailed style: ignored, all strings placed as detailed.\")\n    save_settings(res)\n    if not dim_now and not ref_now:\n        return \"Nothing ticked. Nothing placed.\"\n\n    dim_type = dim_types.get(res[\"dimension_type\"])\n    style_ids = {}\n    if res[\"detail_style\"] in styles:\n        style_ids[eid_int(styles[res[\"detail_style\"]])] = \"detail\"\n    if res[\"overall_style\"] and res[\"overall_style\"] in styles:\n        style_ids[eid_int(styles[res[\"overall_style\"]])] = \"overall\"\n    paths, skipped_curved_paths = collect_paths(doc, view, style_ids)\n    if not paths:\n        return (\"No straight lines with style '{0}'{1} found in this view.\"\n                .format(res[\"detail_style\"],\n                        \" or '{0}'\".format(res[\"overall_style\"]) if res[\"overall_style\"] else \"\"))\n\n    floor_z = paths[0][\"a\"].Z\n    cut_z = cut_plane_z(doc, view, floor_z)\n    zr = view_z_range(doc, view, floor_z)\n\n    chosen = []\n    for en in entries:\n        k = type_key(en[\"cat\"], en[\"label\"])\n        if k in ref_now:\n            en[\"role\"] = \"reference\"\n        elif k in dim_now:\n            en[\"role\"] = \"dimension\"\n        else:\n            continue\n        chosen.append(en)\n\n    warnings = {}\n    sdist = res[\"search_distance_cm\"] * FT_PER_CM\n    recs = build_records(chosen, view, paths, cut_z, zr, sdist, warnings)\n\n    both = sorted(dim_now & ref_now)\n    if both:\n        notes.append(\"Ticked in both tabs, used as Reference only (no opening heights): \" +\n                     \", \".join(k.split(\"|\", 1)[1] for k in both[:8]) + (\" ...\" if len(both) > 8 else \"\"))\n    report = {\"placed\": 0, \"failed\": [], \"openings\": 0, \"small\": 0, \"deleted\": 0, \"empty\": 0,\n              \"jambs\": 0, \"opening_lines\": [],\n              \"recs\": dict((r[\"key\"], r) for r in recs if r[\"type\"] != \"line\")}\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        if res[\"replace_existing\"]:\n            report[\"deleted\"] = delete_dims_on_paths(doc, view, paths)\n        for p in paths:\n            clusters = merge_candidates(build_candidates(p, recs, res))\n            if p[\"mode\"] == \"overall\":\n                clusters = overall_filter(clusters)\n            report[\"jambs\"] += sum(1 for cl in clusters if any(\n                m.get(\"wall_kind\") == \"par\" and m.get(\"partial\") and m.get(\"role\") == \"dimension\"\n                for m in cl[\"metas\"]))\n            if len(clusters) < 2:\n                report[\"empty\"] += 1\n                continue\n            try:\n                place_dimension(doc, view, p, clusters, dim_type, res, report)\n                report[\"placed\"] += 1\n            except Exception as ex:\n                report[\"failed\"].append(\"line {0}: {1}\".format(eid_int(p[\"elem\"].Id), ex))\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    by_cat = {}\n    for r in recs:\n        c = r.get(\"cat\", \"Grids / reference planes\") if r[\"type\"] != \"line\" else \"Grids / reference planes\"\n        by_cat[c] = by_cat.get(c, 0) + 1\n    lines = [\n        \"Path lines found: {0} ({1} detailed, {2} overall)\".format(\n            len(paths), sum(1 for p in paths if p[\"mode\"] == \"detail\"),\n            sum(1 for p in paths if p[\"mode\"] == \"overall\")),\n        \"Dimension strings placed: {0}\".format(report[\"placed\"]),\n        \"Opening jamb faces found: {0}; opening segments labelled with height: {1}\".format(\n            report[\"jambs\"], report[\"openings\"]),\n        \"Elements near the path lines: \" + (\", \".join(\n            \"{0} {1}\".format(n, c) for c, n in sorted(by_cat.items())) or \"none\"),\n    ] + notes\n    if report[\"opening_lines\"]:\n        lvl = view.GenLevel\n        lines.append(\"Openings (cm, relative to the path line z = {0}; level '{1}' project elevation = {2}):\".format(\n            cm(paths[0][\"a\"].Z), lvl.Name if lvl is not None else \"?\",\n            cm(lvl.ProjectElevation) if lvl is not None else \"?\"))\n        lines.extend(report[\"opening_lines\"][:30])\n    if report[\"deleted\"]:\n        lines.append(\"Old dimensions replaced: {0}\".format(report[\"deleted\"]))\n    if report[\"empty\"]:\n        lines.append(\"Path lines with fewer than 2 references (skipped): {0}\".format(report[\"empty\"]))\n    if report[\"small\"]:\n        lines.append(\"Segments under 5 cm (check text overlap): {0}\".format(report[\"small\"]))\n    if skipped_curved_paths:\n        lines.append(\"Curved path lines skipped: {0}\".format(skipped_curved_paths))\n    if warnings.get(\"curved\"):\n        lines.append(\"Curved walls skipped: {0}\".format(warnings[\"curved\"]))\n    if warnings.get(\"linkref\"):\n        lines.append(\"Linked faces that could not be referenced: {0}\".format(warnings[\"linkref\"]))\n    if warnings.get(\"instref\"):\n        lines.append(\"Family faces that could not be referenced: {0}\".format(warnings[\"instref\"]))\n    if report[\"failed\"]:\n        lines.append(\"Failed strings:\")\n        lines.extend(\"  \" + f for f in report[\"failed\"])\n    return \"\\n\".join(lines)\n\n\ndef show_report(text):\n    try:\n        if load_settings().get(\"debug\", False):\n            WF.MessageBox.Show(text, \"Smart Dimensions\")\n    except Exception:\n        pass\n\n\nif REVIT:\n    try:\n        OUT = main()\n    except Exception:\n        OUT = \"Error:\\n\" + traceback.format_exc()\n    if OUT != \"Cancelled.\":\n        show_report(OUT)\n",
