{
  "Uuid": "ba6a8651-d26f-4077-9d96-c6c01a2b1c45",
  "IsCustomNode": false,
  "Description": "Pick sheets in a dialog and export one PDF and/or one DWG per sheet (Revit 2025).",
  "Name": "Sheet Exporter",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Sheet Exporter for Revit 2025 (Dynamo 3.x, CPython3)\n# Opens one dialog: pick sheets (search + saved sheet sets), choose PDF options\n# (same as Revit's native PDF exporter), a DWG export setup, a file-name pattern\n# and an output folder. Exports one PDF and/or one DWG per sheet. DWGs are\n# exported with merged views, so no xref files are created.\n\nimport clr\nimport os\nimport re\nimport json\nimport traceback\n\nclr.AddReference('System')\nclr.AddReference('System.Windows.Forms')\nclr.AddReference('System.Drawing')\nimport System\nfrom System.Collections.Generic import List\nimport System.Windows.Forms as WF\nimport System.Drawing as SD\n\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, ViewSheet, ViewSheetSet,\n                               ViewSet, ElementId, PDFExportOptions, DWGExportOptions,\n                               BaseExportOptions, ExportPDFSettings, ExportPaperFormat,\n                               PageOrientationType, PaperPlacementType, ZoomType,\n                               RasterQualityType, ColorDepthType, PrintRange,\n                               StorageType)\n\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\n# --------------------------------------------------------------------------\n# Settings persistence\n# --------------------------------------------------------------------------\nSETTINGS_DIR = os.path.join(os.environ.get('APPDATA', os.path.expanduser('~')), 'DynamoSheetExporter')\nSETTINGS_FILE = os.path.join(SETTINGS_DIR, 'settings.json')\n\nDEFAULTS = {\n    'pattern': '{Sheet Number} - {Sheet Name}',\n    'folder': os.path.join(os.path.expanduser('~'), 'Documents', 'Sheet Exports'),\n    'export_pdf': True,\n    'export_dwg': True,\n    'dwg_setup': '',\n    'paper_format': 'Default',\n    'orientation': 'Auto',\n    'placement': 'Center',\n    'offset_x': 0.0,\n    'offset_y': 0.0,\n    'zoom_fit': True,\n    'zoom_pct': 100,\n    'raster_hidden': False,\n    'raster_quality': 'High',\n    'color_depth': 'Color',\n    'links_blue': False,\n    'hide_ref': True,\n    'hide_tags': True,\n    'hide_scope': True,\n    'hide_crop': True,\n    'halftone_thin': False,\n    'mask_lines': False,\n}\n\n\ndef load_settings():\n    s = dict(DEFAULTS)\n    try:\n        with open(SETTINGS_FILE, 'r') as f:\n            s.update(json.load(f))\n    except Exception:\n        pass\n    return s\n\n\ndef save_settings(s):\n    try:\n        if not os.path.isdir(SETTINGS_DIR):\n            os.makedirs(SETTINGS_DIR)\n        with open(SETTINGS_FILE, 'w') as f:\n            json.dump(s, f, indent=2)\n    except Exception:\n        pass\n\n\ndef doc_key():\n    return doc.PathName or doc.Title\n\n\n# --------------------------------------------------------------------------\n# Revit helpers\n# --------------------------------------------------------------------------\ndef enum_names(enum_type):\n    # Type.GetEnumNames avoids pythonnet picking the generic Enum.GetNames<TEnum>()\n    return [str(n) for n in clr.GetClrType(enum_type).GetEnumNames()]\n\n\ndef enum_value(enum_type, name):\n    return getattr(enum_type, name)\n\n\ndef get_links_blue(o):\n    for n in ('ViewLinksInBlue', 'ViewLinksinBlue'):\n        if hasattr(o, n):\n            return bool(getattr(o, n))\n    return False\n\n\ndef set_links_blue(o, val):\n    for n in ('ViewLinksInBlue', 'ViewLinksinBlue'):\n        if hasattr(o, n):\n            setattr(o, n, val)\n            return\n\n\ndef enum_name(enum_type, value):\n    try:\n        t = clr.GetClrType(enum_type)\n        for n in t.GetEnumNames():\n            if getattr(enum_type, str(n)) == value:\n                return str(n)\n    except Exception:\n        pass\n    return str(value)\n\n\ndef get_sheets():\n    sheets = [s for s in FilteredElementCollector(doc).OfClass(ViewSheet)\n              if not s.IsPlaceholder]\n    sheets.sort(key=lambda s: s.SheetNumber)\n    return sheets\n\n\ndef get_sheet_sets():\n    sets = {}\n    for vss in FilteredElementCollector(doc).OfClass(ViewSheetSet):\n        nums = []\n        for v in vss.Views:\n            if isinstance(v, ViewSheet):\n                nums.append(v.SheetNumber)\n        sets[vss.Name] = (vss, nums)\n    return sets\n\n\ndef sheet_param_names(sheets):\n    names = set(['Sheet Number', 'Sheet Name'])\n    for s in sheets[:50]:\n        for p in s.Parameters:\n            try:\n                names.add(p.Definition.Name)\n            except Exception:\n                pass\n    return sorted(names, key=lambda n: n.lower())\n\n\ndef param_value(sheet, name):\n    p = sheet.LookupParameter(name)\n    if p is None:\n        if name == 'Sheet Number':\n            return sheet.SheetNumber\n        if name == 'Sheet Name':\n            return sheet.Name\n        return ''\n    if p.StorageType == StorageType.String:\n        return p.AsString() or ''\n    return p.AsValueString() or ''\n\n\nINVALID = re.compile(r'[\\\\/:*?\"<>|]')\n\n\ndef build_name(sheet, pattern):\n    def repl(m):\n        return param_value(sheet, m.group(1))\n    name = re.sub(r'\\{([^{}]+)\\}', repl, pattern)\n    name = INVALID.sub('_', name).strip().rstrip('.')\n    return name or sheet.SheetNumber\n\n\n# --------------------------------------------------------------------------\n# UI helpers\n# --------------------------------------------------------------------------\nFONT = SD.Font('Segoe UI', 9.0)\n\n\ndef label(parent, text, x, y, w=120, h=20):\n    c = WF.Label()\n    c.Text = text\n    c.Location = SD.Point(x, y + 3)\n    c.Size = SD.Size(w, h)\n    parent.Controls.Add(c)\n    return c\n\n\ndef combo(parent, items, x, y, w=180):\n    c = WF.ComboBox()\n    c.DropDownStyle = WF.ComboBoxStyle.DropDownList\n    c.Location = SD.Point(x, y)\n    c.Size = SD.Size(w, 24)\n    for i in items:\n        c.Items.Add(i)\n    parent.Controls.Add(c)\n    return c\n\n\ndef set_combo(c, value):\n    idx = c.Items.IndexOf(value)\n    if idx < 0 and c.Items.Count > 0:\n        idx = 0\n    c.SelectedIndex = idx\n\n\ndef check(parent, text, x, y, w=260):\n    c = WF.CheckBox()\n    c.Text = text\n    c.Location = SD.Point(x, y)\n    c.Size = SD.Size(w, 22)\n    parent.Controls.Add(c)\n    return c\n\n\ndef button(parent, text, x, y, w=80, h=26):\n    c = WF.Button()\n    c.Text = text\n    c.Location = SD.Point(x, y)\n    c.Size = SD.Size(w, h)\n    parent.Controls.Add(c)\n    return c\n\n\ndef numeric(parent, x, y, mn, mx, val, dec=0, w=70):\n    c = WF.NumericUpDown()\n    c.Location = SD.Point(x, y)\n    c.Size = SD.Size(w, 24)\n    c.DecimalPlaces = dec\n    c.Minimum = System.Decimal(mn)\n    c.Maximum = System.Decimal(mx)\n    c.Value = System.Decimal(max(mn, min(mx, val)))\n    parent.Controls.Add(c)\n    return c\n\n\ndef num_val(c):\n    return float(str(c.Value).replace(',', '.'))\n\n\ndef group(parent, text, x, y, w, h):\n    g = WF.GroupBox()\n    g.Text = text\n    g.Location = SD.Point(x, y)\n    g.Size = SD.Size(w, h)\n    parent.Controls.Add(g)\n    return g\n\n\ndef ask_text(title, prompt, default=''):\n    f = WF.Form()\n    f.Text = title\n    f.Font = FONT\n    f.FormBorderStyle = WF.FormBorderStyle.FixedDialog\n    f.StartPosition = WF.FormStartPosition.CenterParent\n    f.MinimizeBox = False\n    f.MaximizeBox = False\n    f.ClientSize = SD.Size(360, 110)\n    label(f, prompt, 12, 10, 330)\n    tb = WF.TextBox()\n    tb.Location = SD.Point(12, 38)\n    tb.Size = SD.Size(334, 24)\n    tb.Text = default\n    f.Controls.Add(tb)\n    ok = button(f, 'OK', 186, 74)\n    ok.DialogResult = WF.DialogResult.OK\n    cancel = button(f, 'Cancel', 270, 74)\n    cancel.DialogResult = WF.DialogResult.Cancel\n    f.AcceptButton = ok\n    f.CancelButton = cancel\n    if f.ShowDialog() == WF.DialogResult.OK and tb.Text.strip():\n        return tb.Text.strip()\n    return None\n\n\ndef msg(text, icon=WF.MessageBoxIcon.Information, buttons=WF.MessageBoxButtons.OK):\n    return WF.MessageBox.Show(text, 'Sheet Exporter', buttons, icon)\n\n\n# --------------------------------------------------------------------------\n# Data\n# --------------------------------------------------------------------------\nsettings = load_settings()\nsheets = get_sheets()\nsheet_by_num = dict((s.SheetNumber, s) for s in sheets)\nchecked = dict((s.SheetNumber, False) for s in sheets)\n\npdf_setup_names = []\ntry:\n    pdf_setup_names = sorted([s.Name for s in FilteredElementCollector(doc).OfClass(ExportPDFSettings)])\nexcept Exception:\n    pass\n\ndwg_setup_names = []\ntry:\n    dwg_setup_names = list(BaseExportOptions.GetPredefinedSetupNames(doc))\nexcept Exception:\n    pass\n\nPAPER_FORMATS = enum_names(ExportPaperFormat)\nPAPER_LABELS = ['Use sheet size' if p == 'Default' else p for p in PAPER_FORMATS]\nORIENTATIONS = ['Auto', 'Portrait', 'Landscape']\nRASTER_Q = ['Low', 'Medium', 'High', 'Presentation']\nCOLORS = [('Color', 'Color'), ('Grayscale', 'GrayScale'), ('Black lines', 'BlackLine')]\n\nstate = {'result': None, 'filling': False}\n\n# --------------------------------------------------------------------------\n# Form\n# --------------------------------------------------------------------------\nform = WF.Form()\nform.SuspendLayout()\nform.AutoScaleDimensions = SD.SizeF(96.0, 96.0)\nform.AutoScaleMode = WF.AutoScaleMode.Dpi\nform.Text = 'Sheet Exporter - ' + doc.Title\nform.Font = FONT\nform.FormBorderStyle = WF.FormBorderStyle.FixedDialog\nform.MaximizeBox = False\nform.StartPosition = WF.FormStartPosition.CenterScreen\nform.ClientSize = SD.Size(1000, 690)\n\n# ---- Sheets (left) --------------------------------------------------------\ngs = group(form, 'Sheets', 10, 8, 440, 630)\nlabel(gs, 'Search', 10, 22, 50)\nsearch = WF.TextBox()\nsearch.Location = SD.Point(64, 22)\nsearch.Size = SD.Size(366, 24)\ngs.Controls.Add(search)\n\nlabel(gs, 'Sheet set', 10, 54, 60)\nset_combo_ctl = combo(gs, [], 74, 54, 166)\nbtn_apply = button(gs, 'Select', 246, 53, 58)\nbtn_save = button(gs, 'Save as...', 308, 53, 70)\nbtn_del = button(gs, 'Delete', 382, 53, 50)\n\nclb = WF.CheckedListBox()\nclb.Location = SD.Point(10, 88)\nclb.Size = SD.Size(420, 500)\nclb.CheckOnClick = True\nclb.IntegralHeight = False\nclb.HorizontalScrollbar = True\ngs.Controls.Add(clb)\n\nbtn_all = button(gs, 'All', 10, 594, 60)\nbtn_none = button(gs, 'None', 74, 594, 60)\ncount_lbl = label(gs, '', 146, 594, 284)\n\nvisible_nums = []\n\n\ndef sheet_label(s):\n    return s.SheetNumber + '  -  ' + s.Name\n\n\ndef refresh_list(*args):\n    state['filling'] = True\n    clb.BeginUpdate()\n    clb.Items.Clear()\n    del visible_nums[:]\n    q = search.Text.strip().lower()\n    widest = 0\n    for s in sheets:\n        text = sheet_label(s)\n        if q and q not in text.lower():\n            continue\n        visible_nums.append(s.SheetNumber)\n        idx = clb.Items.Add(text)\n        widest = max(widest, WF.TextRenderer.MeasureText(text, clb.Font).Width)\n        if checked[s.SheetNumber]:\n            clb.SetItemChecked(idx, True)\n    clb.HorizontalExtent = widest + 30   # room for the checkbox\n    clb.EndUpdate()\n    state['filling'] = False\n    update_count()\n\n\ndef update_count():\n    n = sum(1 for v in checked.values() if v)\n    count_lbl.Text = '%d of %d sheets selected' % (n, len(sheets))\n    update_preview()\n\n\ndef on_item_check(sender, e):\n    if state['filling']:\n        return\n    num = visible_nums[e.Index]\n    checked[num] = (e.NewValue == WF.CheckState.Checked)\n    # count updates after the check state actually changes\n    form.BeginInvoke(System.Action(update_count))\n\n\ndef set_visible(val):\n    for n in visible_nums:\n        checked[n] = val\n    refresh_list()\n\n\ndef reload_sets(select=None):\n    set_combo_ctl.Items.Clear()\n    for name in sorted(get_sheet_sets().keys(), key=lambda n: n.lower()):\n        set_combo_ctl.Items.Add(name)\n    if select and set_combo_ctl.Items.IndexOf(select) >= 0:\n        set_combo_ctl.SelectedIndex = set_combo_ctl.Items.IndexOf(select)\n    elif set_combo_ctl.Items.Count > 0:\n        set_combo_ctl.SelectedIndex = 0\n\n\ndef on_apply_set(sender, e):\n    name = set_combo_ctl.SelectedItem\n    if name is None:\n        return\n    sets = get_sheet_sets()\n    if name not in sets:\n        return\n    nums = set(sets[name][1])\n    for n in checked:\n        checked[n] = n in nums\n    refresh_list()\n\n\ndef on_save_set(sender, e):\n    nums = [n for n, v in checked.items() if v]\n    if not nums:\n        msg('Select at least one sheet first.', WF.MessageBoxIcon.Warning)\n        return\n    name = ask_text('Save sheet set', 'Name for the sheet set (saved in this Revit model):',\n                    set_combo_ctl.SelectedItem or '')\n    if not name:\n        return\n    sets = get_sheet_sets()\n    if name in sets:\n        if msg('A sheet set named \"%s\" already exists. Replace it?' % name,\n               WF.MessageBoxIcon.Question, WF.MessageBoxButtons.YesNo) != WF.DialogResult.Yes:\n            return\n    try:\n        vs = ViewSet()\n        for n in nums:\n            vs.Insert(sheet_by_num[n])\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        pm = doc.PrintManager\n        pm.PrintRange = PrintRange.Select\n        vsetting = pm.ViewSheetSetting\n        if name in sets:\n            vsetting.CurrentViewSheetSet = sets[name][0]\n            vsetting.CurrentViewSheetSet.Views = vs\n            vsetting.Save()\n        else:\n            vsetting.CurrentViewSheetSet.Views = vs\n            vsetting.SaveAs(name)\n        TransactionManager.Instance.TransactionTaskDone()\n        TransactionManager.Instance.ForceCloseTransaction()\n        reload_sets(name)\n    except Exception as ex:\n        try:\n            TransactionManager.Instance.ForceCloseTransaction()\n        except Exception:\n            pass\n        msg('Could not save the sheet set:\\n' + str(ex), WF.MessageBoxIcon.Error)\n\n\ndef on_delete_set(sender, e):\n    name = set_combo_ctl.SelectedItem\n    if name is None:\n        return\n    if msg('Delete the sheet set \"%s\" from this Revit model?' % name,\n           WF.MessageBoxIcon.Question, WF.MessageBoxButtons.YesNo) != WF.DialogResult.Yes:\n        return\n    sets = get_sheet_sets()\n    if name not in sets:\n        return\n    try:\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        doc.Delete(sets[name][0].Id)\n        TransactionManager.Instance.TransactionTaskDone()\n        TransactionManager.Instance.ForceCloseTransaction()\n        reload_sets()\n    except Exception as ex:\n        try:\n            TransactionManager.Instance.ForceCloseTransaction()\n        except Exception:\n            pass\n        msg('Could not delete the sheet set:\\n' + str(ex), WF.MessageBoxIcon.Error)\n\n\nsearch.TextChanged += refresh_list\nclb.ItemCheck += on_item_check\nbtn_all.Click += lambda s, e: set_visible(True)\nbtn_none.Click += lambda s, e: set_visible(False)\nbtn_apply.Click += on_apply_set\nbtn_save.Click += on_save_set\nbtn_del.Click += on_delete_set\n\n# ---- PDF (right top) ------------------------------------------------------\ngp = group(form, 'PDF options (same as Revit\\'s PDF export)', 460, 8, 530, 370)\nchk_pdf = check(gp, 'Export PDF (one file per sheet)', 12, 20, 250)\nlabel(gp, 'Load project setup', 270, 20, 120)\npdf_setup = combo(gp, ['<current settings>'] + pdf_setup_names, 390, 20, 130)\n\nlabel(gp, 'Paper format', 12, 52, 100)\npaper = combo(gp, PAPER_LABELS, 112, 52, 150)\nlabel(gp, 'Orientation', 280, 52, 80)\norient = combo(gp, ORIENTATIONS, 362, 52, 100)\n\nlabel(gp, 'Placement', 12, 84, 100)\nplace_center = WF.RadioButton()\nplace_center.Text = 'Center'\nplace_center.Location = SD.Point(112, 84)\nplace_center.Size = SD.Size(70, 22)\nplace_offset = WF.RadioButton()\nplace_offset.Text = 'Offset from corner'\nplace_offset.Location = SD.Point(186, 84)\nplace_offset.Size = SD.Size(130, 22)\ngp.Controls.Add(place_center)\ngp.Controls.Add(place_offset)\nlabel(gp, 'X', 322, 84, 14)  # offsets shown in mm\noff_x = numeric(gp, 338, 84, -1000, 1000, settings['offset_x'], 1, 66)\nlabel(gp, 'Y', 410, 84, 14)\noff_y = numeric(gp, 426, 84, -1000, 1000, settings['offset_y'], 1, 66)\nlabel(gp, 'mm', 494, 84, 30)\n\nlabel(gp, 'Zoom', 12, 116, 100)\npnl_zoom = WF.Panel()\npnl_zoom.Location = SD.Point(112, 114)\npnl_zoom.Size = SD.Size(300, 28)\ngp.Controls.Add(pnl_zoom)\nzoom_fit = WF.RadioButton()\nzoom_fit.Text = 'Fit to page'\nzoom_fit.Location = SD.Point(0, 2)\nzoom_fit.Size = SD.Size(90, 22)\nzoom_pct_rb = WF.RadioButton()\nzoom_pct_rb.Text = 'Zoom'\nzoom_pct_rb.Location = SD.Point(96, 2)\nzoom_pct_rb.Size = SD.Size(60, 22)\npnl_zoom.Controls.Add(zoom_fit)\npnl_zoom.Controls.Add(zoom_pct_rb)\nzoom_pct = numeric(pnl_zoom, 158, 2, 1, 1000, settings['zoom_pct'], 0, 60)\nlabel(pnl_zoom, '%', 222, 0, 20)\n\nlabel(gp, 'Hidden line views', 12, 150, 100)\npnl_hl = WF.Panel()\npnl_hl.Location = SD.Point(112, 148)\npnl_hl.Size = SD.Size(300, 28)\ngp.Controls.Add(pnl_hl)\nhl_vector = WF.RadioButton()\nhl_vector.Text = 'Vector processing'\nhl_vector.Location = SD.Point(0, 2)\nhl_vector.Size = SD.Size(130, 22)\nhl_raster = WF.RadioButton()\nhl_raster.Text = 'Raster processing'\nhl_raster.Location = SD.Point(136, 2)\nhl_raster.Size = SD.Size(130, 22)\npnl_hl.Controls.Add(hl_vector)\npnl_hl.Controls.Add(hl_raster)\n\nlabel(gp, 'Raster quality', 12, 184, 100)\nrq = combo(gp, RASTER_Q, 112, 184, 150)\nlabel(gp, 'Colors', 280, 184, 60)\ncolors = combo(gp, [c[0] for c in COLORS], 342, 184, 120)\n\nchk_links = check(gp, 'View links in blue', 12, 220, 240)\nchk_ref = check(gp, 'Hide ref/work planes', 12, 244, 240)\nchk_tags = check(gp, 'Hide unreferenced view tags', 12, 268, 240)\nchk_scope = check(gp, 'Hide scope boxes', 12, 292, 240)\nchk_crop = check(gp, 'Hide crop boundaries', 270, 220, 250)\nchk_half = check(gp, 'Replace halftone with thin lines', 270, 244, 250)\nchk_mask = check(gp, 'Region edges mask coincident lines', 270, 268, 250)\n\n\ndef update_pdf_enabled(*args):\n    on = chk_pdf.Checked\n    for c in (pdf_setup, paper, orient, place_center, place_offset, pnl_zoom, pnl_hl,\n              rq, colors, chk_links, chk_ref, chk_tags, chk_scope, chk_crop, chk_half, chk_mask):\n        c.Enabled = on\n    orient.Enabled = on and paper.SelectedIndex > 0 and PAPER_FORMATS[paper.SelectedIndex] != 'Default'\n    off_x.Enabled = on and place_offset.Checked\n    off_y.Enabled = on and place_offset.Checked\n    zoom_pct.Enabled = on and zoom_pct_rb.Checked\n\n\ndef fill_pdf(d):\n    \"\"\"d: dict with the same keys as settings.\"\"\"\n    pf = d.get('paper_format', 'Default')\n    paper.SelectedIndex = PAPER_FORMATS.index(pf) if pf in PAPER_FORMATS else 0\n    set_combo(orient, d.get('orientation', 'Auto'))\n    place_center.Checked = d.get('placement', 'Center') == 'Center'\n    place_offset.Checked = not place_center.Checked\n    off_x.Value = System.Decimal(max(-1000.0, min(1000.0, float(d.get('offset_x', 0.0)))))\n    off_y.Value = System.Decimal(max(-1000.0, min(1000.0, float(d.get('offset_y', 0.0)))))\n    zoom_fit.Checked = bool(d.get('zoom_fit', True))\n    zoom_pct_rb.Checked = not zoom_fit.Checked\n    zoom_pct.Value = System.Decimal(int(max(1, min(1000, d.get('zoom_pct', 100)))))\n    hl_raster.Checked = bool(d.get('raster_hidden', False))\n    hl_vector.Checked = not hl_raster.Checked\n    set_combo(rq, d.get('raster_quality', 'High'))\n    cd = d.get('color_depth', 'Color')\n    colors.SelectedIndex = [c[1] for c in COLORS].index(cd) if cd in [c[1] for c in COLORS] else 0\n    chk_links.Checked = bool(d.get('links_blue', False))\n    chk_ref.Checked = bool(d.get('hide_ref', True))\n    chk_tags.Checked = bool(d.get('hide_tags', True))\n    chk_scope.Checked = bool(d.get('hide_scope', True))\n    chk_crop.Checked = bool(d.get('hide_crop', True))\n    chk_half.Checked = bool(d.get('halftone_thin', False))\n    chk_mask.Checked = bool(d.get('mask_lines', False))\n    update_pdf_enabled()\n\n\ndef options_to_dict(o):\n    return {\n        'paper_format': enum_name(ExportPaperFormat, o.PaperFormat),\n        'orientation': enum_name(PageOrientationType, o.PaperOrientation),\n        'placement': enum_name(PaperPlacementType, o.PaperPlacement),\n        'offset_x': o.OriginOffsetX * 304.8,   # API stores feet\n        'offset_y': o.OriginOffsetY * 304.8,\n        'zoom_fit': enum_name(ZoomType, o.ZoomType) == 'FitToPage',\n        'zoom_pct': o.ZoomPercentage,\n        'raster_hidden': o.AlwaysUseRaster,\n        'raster_quality': enum_name(RasterQualityType, o.RasterQuality),\n        'color_depth': enum_name(ColorDepthType, o.ColorDepth),\n        'links_blue': get_links_blue(o),\n        'hide_ref': o.HideReferencePlane,\n        'hide_tags': o.HideUnreferencedViewTags,\n        'hide_scope': o.HideScopeBoxes,\n        'hide_crop': o.HideCropBoundaries,\n        'halftone_thin': o.ReplaceHalftoneWithThinLines,\n        'mask_lines': o.MaskCoincidentLines,\n    }\n\n\ndef read_pdf_controls():\n    return {\n        'paper_format': PAPER_FORMATS[max(0, paper.SelectedIndex)],\n        'orientation': orient.SelectedItem or 'Auto',\n        'placement': 'Center' if place_center.Checked else 'LowerLeft',\n        'offset_x': num_val(off_x),\n        'offset_y': num_val(off_y),\n        'zoom_fit': zoom_fit.Checked,\n        'zoom_pct': int(num_val(zoom_pct)),\n        'raster_hidden': hl_raster.Checked,\n        'raster_quality': rq.SelectedItem or 'High',\n        'color_depth': COLORS[max(0, colors.SelectedIndex)][1],\n        'links_blue': chk_links.Checked,\n        'hide_ref': chk_ref.Checked,\n        'hide_tags': chk_tags.Checked,\n        'hide_scope': chk_scope.Checked,\n        'hide_crop': chk_crop.Checked,\n        'halftone_thin': chk_half.Checked,\n        'mask_lines': chk_mask.Checked,\n    }\n\n\ndef on_pdf_setup(sender, e):\n    if pdf_setup.SelectedIndex <= 0:\n        return\n    name = pdf_setup.SelectedItem\n    try:\n        ps = ExportPDFSettings.FindByName(doc, name)\n        fill_pdf(options_to_dict(ps.GetOptions()))\n    except Exception as ex:\n        msg('Could not read the PDF setup \"%s\":\\n%s' % (name, ex), WF.MessageBoxIcon.Warning)\n\n\npdf_setup.SelectedIndexChanged += on_pdf_setup\nfor c in (chk_pdf, place_offset, zoom_pct_rb):\n    c.CheckedChanged += update_pdf_enabled\npaper.SelectedIndexChanged += update_pdf_enabled\n\n# ---- DWG (right middle) ---------------------------------------------------\ngd = group(form, 'DWG options', 460, 384, 530, 84)\nchk_dwg = check(gd, 'Export DWG (one file per sheet)', 12, 20, 250)\nlabel(gd, 'Export setup', 270, 20, 80)\ndwg_setup = combo(gd, ['<default settings>'] + dwg_setup_names, 352, 20, 168)\nlabel(gd, 'Views on sheets are merged into each sheet\\'s DWG, so no xref files are created.',\n      12, 50, 510)\nchk_dwg.CheckedChanged += lambda s, e: setattr(dwg_setup, 'Enabled', chk_dwg.Checked)\n\n# ---- Output (right bottom) ------------------------------------------------\ngo = group(form, 'Output', 460, 474, 530, 164)\nlabel(go, 'Folder', 12, 22, 70)\nfolder_tb = WF.TextBox()\nfolder_tb.Location = SD.Point(84, 22)\nfolder_tb.Size = SD.Size(346, 24)\ngo.Controls.Add(folder_tb)\nbtn_browse = button(go, 'Browse...', 436, 21, 84)\n\nlabel(go, 'File name', 12, 56, 70)\npattern_tb = WF.TextBox()\npattern_tb.Location = SD.Point(84, 56)\npattern_tb.Size = SD.Size(436, 24)\ngo.Controls.Add(pattern_tb)\n\nlabel(go, 'Parameter', 12, 90, 70)\nparam_combo = combo(go, sheet_param_names(sheets), 84, 90, 260)\nbtn_insert = button(go, 'Insert', 350, 89, 70)\nbtn_reset = button(go, 'Default', 426, 89, 94)\npreview_lbl = label(go, '', 12, 126, 508, 22)\npreview_lbl.ForeColor = SD.Color.DimGray\n\n\ndef update_preview(*args):\n    first = None\n    for s in sheets:\n        if checked[s.SheetNumber]:\n            first = s\n            break\n    if first is None and sheets:\n        first = sheets[0]\n    if first is None:\n        preview_lbl.Text = 'No sheets in this model.'\n        return\n    preview_lbl.Text = 'Example: ' + build_name(first, pattern_tb.Text) + '.pdf / .dwg'\n\n\ndef on_browse(sender, e):\n    d = WF.FolderBrowserDialog()\n    d.Description = 'Choose the export folder'\n    if os.path.isdir(folder_tb.Text):\n        d.SelectedPath = folder_tb.Text\n    if d.ShowDialog() == WF.DialogResult.OK:\n        folder_tb.Text = d.SelectedPath\n\n\ndef on_insert(sender, e):\n    if param_combo.SelectedItem is None:\n        return\n    token = '{' + param_combo.SelectedItem + '}'\n    pos = pattern_tb.SelectionStart\n    pattern_tb.Text = pattern_tb.Text[:pos] + token + pattern_tb.Text[pos + pattern_tb.SelectionLength:]\n    pattern_tb.SelectionStart = pos + len(token)\n    pattern_tb.Focus()\n\n\nbtn_browse.Click += on_browse\nbtn_insert.Click += on_insert\nbtn_reset.Click += lambda s, e: setattr(pattern_tb, 'Text', DEFAULTS['pattern'])\npattern_tb.TextChanged += update_preview\n\n# ---- Bottom buttons -------------------------------------------------------\nbtn_export = button(form, 'Export', 812, 650, 86, 30)\nbtn_cancel = button(form, 'Cancel', 904, 650, 86, 30)\nbtn_cancel.DialogResult = WF.DialogResult.Cancel\nform.CancelButton = btn_cancel\n\n\ndef on_export(sender, e):\n    nums = [s.SheetNumber for s in sheets if checked[s.SheetNumber]]\n    if not nums:\n        msg('Select at least one sheet.', WF.MessageBoxIcon.Warning)\n        return\n    if not chk_pdf.Checked and not chk_dwg.Checked:\n        msg('Tick PDF, DWG or both.', WF.MessageBoxIcon.Warning)\n        return\n    folder = folder_tb.Text.strip()\n    if not folder:\n        msg('Choose an output folder.', WF.MessageBoxIcon.Warning)\n        return\n    if not pattern_tb.Text.strip():\n        msg('Enter a file name pattern.', WF.MessageBoxIcon.Warning)\n        return\n    names = [build_name(sheet_by_num[n], pattern_tb.Text) for n in nums]\n    dupes = sorted(set(x for x in names if names.count(x) > 1))\n    if dupes:\n        if msg('These file names repeat, so later sheets would overwrite earlier ones:\\n\\n' +\n               '\\n'.join(dupes[:10]) + '\\n\\nExport anyway?',\n               WF.MessageBoxIcon.Warning, WF.MessageBoxButtons.YesNo) != WF.DialogResult.Yes:\n            return\n    state['result'] = {\n        'sheets': nums,\n        'folder': folder,\n        'pattern': pattern_tb.Text,\n        'export_pdf': chk_pdf.Checked,\n        'export_dwg': chk_dwg.Checked,\n        'dwg_setup': dwg_setup.SelectedItem if dwg_setup.SelectedIndex > 0 else '',\n        'pdf': read_pdf_controls(),\n    }\n    form.DialogResult = WF.DialogResult.OK\n    form.Close()\n\n\nbtn_export.Click += on_export\n\n# ---- Initial values -------------------------------------------------------\nchk_pdf.Checked = bool(settings['export_pdf'])\nchk_dwg.Checked = bool(settings['export_dwg'])\nfill_pdf(settings)\npdf_setup.SelectedIndex = 0\nset_combo(dwg_setup, settings['dwg_setup'] or '<default settings>')\ndwg_setup.Enabled = chk_dwg.Checked\nfolder_tb.Text = settings['folder']\npattern_tb.Text = settings['pattern']\nif param_combo.Items.Count > 0:\n    param_combo.SelectedIndex = 0\nreload_sets()\nrefresh_list()\n\nform.ResumeLayout(False)\n\n# --------------------------------------------------------------------------\n# Export\n# --------------------------------------------------------------------------\ndef make_pdf_options(p):\n    o = PDFExportOptions()\n    o.Combine = True        # one sheet per call, so FileName controls the name\n    o.PaperFormat = enum_value(ExportPaperFormat, p['paper_format'])\n    if p['paper_format'] != 'Default':\n        o.PaperOrientation = enum_value(PageOrientationType, p['orientation'])\n    o.PaperPlacement = enum_value(PaperPlacementType, p['placement'])\n    if p['placement'] == 'LowerLeft':\n        o.OriginOffsetX = p['offset_x'] / 304.8   # mm -> feet\n        o.OriginOffsetY = p['offset_y'] / 304.8\n    if p['zoom_fit']:\n        o.ZoomType = ZoomType.FitToPage\n    else:\n        o.ZoomType = ZoomType.Zoom\n        o.ZoomPercentage = int(p['zoom_pct'])\n    o.AlwaysUseRaster = p['raster_hidden']\n    o.RasterQuality = enum_value(RasterQualityType, p['raster_quality'])\n    o.ColorDepth = enum_value(ColorDepthType, p['color_depth'])\n    set_links_blue(o, p['links_blue'])\n    o.HideReferencePlane = p['hide_ref']\n    o.HideUnreferencedViewTags = p['hide_tags']\n    o.HideScopeBoxes = p['hide_scope']\n    o.HideCropBoundaries = p['hide_crop']\n    o.ReplaceHalftoneWithThinLines = p['halftone_thin']\n    o.MaskCoincidentLines = p['mask_lines']\n    return o\n\n\ndef make_dwg_options(setup):\n    o = None\n    if setup:\n        try:\n            o = DWGExportOptions.GetPredefinedOptions(doc, setup)\n        except Exception:\n            o = None\n    if o is None:\n        o = DWGExportOptions()\n    o.MergedViews = True    # no xrefs: views are bound into the sheet's DWG\n    return o\n\n\nreport = []\ntry:\n    form_result = form.ShowDialog()\nexcept Exception:\n    form_result = None\n    report.append('Dialog error:\\n' + traceback.format_exc())\n\nres = state['result']\nif form_result == WF.DialogResult.OK and res:\n    # remember everything for next time\n    settings.update(res['pdf'])\n    settings['folder'] = res['folder']\n    settings['pattern'] = res['pattern']\n    settings['export_pdf'] = res['export_pdf']\n    settings['export_dwg'] = res['export_dwg']\n    settings['dwg_setup'] = res['dwg_setup']\n    settings.pop('selection', None)\n    save_settings(settings)\n\n    folder = res['folder']\n    if not os.path.isdir(folder):\n        os.makedirs(folder)\n\n    # exports cannot run while Dynamo holds a transaction open\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n\n    pdf_opts = make_pdf_options(res['pdf']) if res['export_pdf'] else None\n    dwg_opts = make_dwg_options(res['dwg_setup']) if res['export_dwg'] else None\n\n    ok_pdf, ok_dwg, errors, created = 0, 0, [], []\n    n = len(res['sheets'])\n    steps = n * ((1 if pdf_opts is not None else 0) + (1 if dwg_opts is not None else 0))\n    cancel = {'requested': False}\n\n    # progress window (modeless, kept alive with DoEvents between files)\n    pf = WF.Form()\n    pf.Text = 'Sheet Exporter - exporting'\n    pf.Font = FONT\n    pf.FormBorderStyle = WF.FormBorderStyle.FixedDialog\n    pf.StartPosition = WF.FormStartPosition.CenterScreen\n    pf.MinimizeBox = False\n    pf.MaximizeBox = False\n    pf.TopMost = True\n    pf.ClientSize = SD.Size(460, 120)\n    p_lbl = label(pf, 'Starting...', 12, 10, 436, 22)\n    p_bar = WF.ProgressBar()\n    p_bar.Location = SD.Point(12, 40)\n    p_bar.Size = SD.Size(436, 22)\n    p_bar.Minimum = 0\n    p_bar.Maximum = max(1, steps)\n    pf.Controls.Add(p_bar)\n    p_cancel = button(pf, 'Cancel', 362, 78, 86, 30)\n\n    def request_cancel(*args):\n        cancel['requested'] = True\n        p_cancel.Enabled = False\n        p_lbl.Text = 'Cancelling after the current file...'\n\n    def on_progress_closing(sender, e):\n        if not cancel.get('done'):\n            e.Cancel = True\n            request_cancel()\n\n    p_cancel.Click += request_cancel\n    pf.FormClosing += on_progress_closing\n    pf.Show()\n    WF.Application.DoEvents()\n\n    t_start = System.DateTime.Now\n    step = 0\n\n    def tick(text):\n        p_lbl.Text = text\n        p_bar.Value = min(step, p_bar.Maximum)\n        WF.Application.DoEvents()\n\n    for i, num in enumerate(res['sheets']):\n        if cancel['requested']:\n            break\n        sheet = sheet_by_num[num]\n        name = build_name(sheet, res['pattern'])\n        ids = List[ElementId]()\n        ids.Add(sheet.Id)\n        if pdf_opts is not None and not cancel['requested']:\n            tick('Sheet %d of %d  -  PDF  -  %s' % (i + 1, n, name))\n            try:\n                pdf_opts.FileName = name\n                if doc.Export(folder, ids, pdf_opts):\n                    ok_pdf += 1\n                    created.append(os.path.join(folder, name + '.pdf'))\n                else:\n                    errors.append('PDF  %s: Revit reported a failure' % num)\n            except Exception as ex:\n                errors.append('PDF  %s: %s' % (num, ex))\n            step += 1\n        if dwg_opts is not None and not cancel['requested']:\n            tick('Sheet %d of %d  -  DWG  -  %s' % (i + 1, n, name))\n            try:\n                if doc.Export(folder, name, ids, dwg_opts):\n                    ok_dwg += 1\n                    created.append(os.path.join(folder, name + '.dwg'))\n                else:\n                    errors.append('DWG  %s: Revit reported a failure' % num)\n            except Exception as ex:\n                errors.append('DWG  %s: %s' % (num, ex))\n            step += 1\n        tick(p_lbl.Text)\n\n    t_end = System.DateTime.Now\n    cancel['done'] = True\n    pf.Close()\n\n    deleted = 0\n    if cancel['requested'] and created:\n        if msg('Export cancelled. %d file(s) were exported before you cancelled.\\n\\n'\n               'Delete them too?' % len(created),\n               WF.MessageBoxIcon.Question, WF.MessageBoxButtons.YesNo) == WF.DialogResult.Yes:\n            for f in created:\n                try:\n                    if os.path.isfile(f):\n                        os.remove(f)\n                        deleted += 1\n                except Exception as ex:\n                    errors.append('Could not delete %s: %s' % (f, ex))\n\n    dur = t_end.Subtract(t_start)   # .NET DateTime has no Python '-' in CPython3\n    dur_txt = '%d:%02d:%02d' % (int(dur.TotalHours), dur.Minutes, dur.Seconds)\n    if cancel['requested']:\n        summary = 'Export CANCELLED  -  %s\\n' % folder\n    else:\n        summary = 'Exported to %s\\n' % folder\n    summary += '\\nStarted:   %s\\nFinished:  %s\\nDuration:  %s\\n\\n' % (\n        t_start.ToString('yyyy-MM-dd HH:mm:ss'), t_end.ToString('yyyy-MM-dd HH:mm:ss'), dur_txt)\n    if pdf_opts is not None:\n        summary += 'PDF: %d of %d\\n' % (ok_pdf, n)\n    if dwg_opts is not None:\n        summary += 'DWG: %d of %d\\n' % (ok_dwg, n)\n    if deleted:\n        summary += 'Deleted after cancel: %d file(s)\\n' % deleted\n    if errors:\n        summary += '\\nProblems:\\n' + '\\n'.join(errors[:20])\n        if len(errors) > 20:\n            summary += '\\n... and %d more' % (len(errors) - 20)\n    report.append(summary)\n    msg(summary)\nelif not report:\n    report.append('Cancelled.')\n\nOUT = '\\n'.join(report)\n",
      "Engine": "CPython3",
